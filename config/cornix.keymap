#include "zmk-helpers/helper.h"
#include "includes/cornix54.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

// tap windows for ctl alt and gui

// quick tapping for shift
#define BASE 0
#define NUM 1
#define FUNC 2
#define BT 3

// https://github.com/urob/zmk-config/tree/main#timeless-homerow-mods

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// Add
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>

#define JIS_MODS <(MOD_LSFT|MOD_RSFT)>

/ {
    // Activate ADJUST layer by pressing raise and lower

    behaviors {
        /* ` / ~   : JP_GRV = S(LBKT) , JP_TILD = S(EQUAL) */
        jp_grv: jp_grave_tilde {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(LBKT)>, <&kp LS(EQUAL)>;
            mods = JIS_MODS;
        };

        /* 2 / @   : JP_AT = LBKT */
        jp_2: jp_2_at {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N2>, <&kp LBKT>;
            mods = JIS_MODS;
        };

        /* 6 / ^   : JP_CIRC = EQUAL */
        jp_6: jp_6_circumflex {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N6>, <&kp EQUAL>;
            mods = JIS_MODS;
        };

        /* 7 / &   : JP_AMPR = S(N6) */
        jp_7: jp_7_ampersand {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N7>, <&kp LS(N6)>;
            mods = JIS_MODS;
        };

        /* 8 / *   : JP_ASTR = S(SQT) */
        jp_8: jp_8_asterisk {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N8>, <&kp LS(SQT)>;
            mods = JIS_MODS;
        };

        /* 9 / (   : JP_LPRN = S(N8) */
        jp_9: jp_9_lparen {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N9>, <&kp LS(N8)>;
            mods = JIS_MODS;
        };

        /* 0 / )   : JP_RPRN = S(N9) */
        jp_0: jp_0_rparen {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N0>, <&kp LS(N9)>;
            mods = JIS_MODS;
        };

        /* - / _   : JP_MINS = MINUS , JP_UNDS = S(INT1) */
        jp_mins: jp_minus_underscore {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp LS(INT1)>;
            mods = JIS_MODS;
        };

        /* = / +   : JP_EQL = S(MINUS) , JP_PLUS = S(SEMI) */
        jp_eql: jp_equal_plus {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(MINUS)>, <&kp LS(SEMI)>;
            mods = JIS_MODS;
        };

        /* [ / {   : JP_LBRC = RBKT , JP_LCBR = S(RBKT) */
        jp_lbrc: jp_lbracket_lbrace {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RBKT>, <&kp LS(RBKT)>;
            mods = JIS_MODS;
        };

        /* ] / }   : JP_RBRC = NON_US_HASH , JP_RCBR = S(NON_US_HASH) */
        jp_rbrc: jp_rbracket_rbrace {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp NON_US_HASH>, <&kp LS(NON_US_HASH)>;
            mods = JIS_MODS;
        };

        /* \ / |   : JP_BSLS = INT1 (ro) , JP_PIPE = S(INT3) (yen) */
        jp_bsls: jp_backslash_pipe {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp INT1>, <&kp LS(INT3)>;
            mods = JIS_MODS;
        };

        /* ; / :   : JP_SCLN = SEMI , JP_COLN = SQT */
        jp_scln: jp_semicolon_colon {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SEMI>, <&kp SQT>;
            mods = JIS_MODS;
        };

        /* ' / "   : JP_QUOT = S(N7) , JP_DQUO = S(N2) */
        jp_quot: jp_quote_dquote {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(N7)>, <&kp LS(N2)>;
            mods = JIS_MODS;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";

            // -------------------------------------------------------------------------------------------------------------------------------
            // | TAB    | Q      | W      | E      | R      | T      |                 | Y      | U      | I      | O      | P      | BKSPC  |
            // | CAPS   | A      | S      | D      | F      | G      |        |        | H      | J      | K      | L      | ;      | ENTER  |
            // | SHIFT  | Z      | X      | C      | V      | B      | MUTE   |        | N      | M      | ,      | .      | /      | \      |
            // | CTRL   | WIN    | ALT    | MO(2)  | SPACE  | MO(1)  |        |        | MO(1)  | SPACE  | MO(2)  | MO(3)  | HOME   | END    |

            bindings = <
                &kp TAB    &kp Q     &kp W     &kp E  &kp R      &kp T                       &kp Y      &kp U      &kp I      &kp O     &kp P     &kp BSPC
                &kp CAPS   &kp A     &kp S     &kp D  &kp F      &kp G                       &kp H      &kp J      &kp K      &kp L     &jp_scln  &kp ENTER
                &kp LSHFT  &kp Z     &kp X     &kp C  &kp V      &kp B  &kp C_MUTE  &none    &kp N      &kp M      &kp COMMA  &kp DOT   &kp FSLH  &jp_bsls
                &kp LCTRL  &kp LGUI  &kp LALT  &mo 2  &kp SPACE  &mo 1                       &mo 1      &kp SPACE  &mo 2      &mo 3     &kp HOME  &kp END
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        NUM_layer {
            display-name = "Number";

            // -------------------------------------------------------------------------------------------------------------------------------
            // | `      | 1      | 2      | 3      | 4      | 5      |                 | 6      | 7      | 8      | 9      | 0      | DELETE |
            // |        |        |        |        |        |        |                 | =      | '      | ↑      |        |        |        |
            // |        |        |        |        |        |        |        |        | -      | ←      | ↓      | →      | [      |  ]     |
            // |        |        |        |        |        |        |                 |        |        |        |        |        |        |

            bindings = <
                &jp_grv    &kp N1  &jp_2   &kp N3  &kp N4  &kp N5                     &jp_6       &jp_7     &jp_8      &jp_9      &jp_0      &kp DEL
                &trans     &trans  &trans  &trans  &trans  &trans                     &jp_eql     &jp_quot  &kp UP     &trans     &trans     &trans
                &trans     &trans  &trans  &trans  &trans  &trans  &trans   &trans    &jp_mins    &kp LEFT  &kp DOWN   &kp RIGHT  &jp_lbrc   &jp_rbrc
                &trans     &trans  &trans  &trans  &trans  &trans                     &trans      &trans    &trans     &trans     &trans     &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Func_layer {
            display-name = "Functions";

            // -----------------------------------------------------------------------------------------------------------------
            // |        | F1     | F2     | F3     | F4     | F5     |                 | F6     | F7     | F8     | F9     | F10    |        |
            // |        |        |        |        |        |        |                 |        |        |        |        | F11    | F12    |
            // |        |        |        |        |        |        |        |        |        |        |        |        | [      | ]      |
            // |        |        |        |        |        |        |                 |        |        |        |        |        |        |

            bindings = <
                &trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5                    &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &trans
                &trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &kp F11  &kp F12
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &jp_lbrc &jp_rbrc
                &trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans   &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        BT_layer {
            display-name = "BlueTooth";

            // -------------------------------------------------------------------------------------------------------------------------------
            // | BT(CLR)| BT(USB)| BT(BLE)|        |        |        |        |        |        |        |        |        |        |        |
            // | BT(0)  |        |        |        |        |        |        |        |        |        |        |        |        |        |
            // | BT(1)  |        |        |        |        |        |        |        |        |        |        |        |        |        |
            // | BT(2)  |        |        |        |        |        |        |        |        |        |        |        |        |        |

            bindings = <
                &out OUT_USB   &out OUT_BLE  &bt BT_CLR_ALL  &bt BT_CLR &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
                &bt BT_SEL 0   &trans        &trans          &trans     &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
                &bt BT_SEL 1   &trans        &trans          &trans     &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                &bt BT_SEL 2   &trans        &trans          &trans     &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
